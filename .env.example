# WhatsApp Provider Configuration
WHATSAPP_PROVIDER=infobip

# Infobip Configuration
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=your_sender_number
INFOBIP_WEBHOOK_SECRET=your_webhook_secret_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SENDER=your_twilio_sender_number
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret_here

# Meta Configuration (Instagram + Facebook Messenger)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ID=your_meta_page_id_here
META_VERIFY_TOKEN=your_meta_verify_token_here
META_API_VERSION=v21.0

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_adapter
DB_USERNAME=root
DB_PASSWORD=

# Redis Configuration (for cache and rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Logging Configuration
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Critical Error Notifications
CRITICAL_ERROR_EMAIL_ENABLED=false
CRITICAL_ERROR_EMAIL_TO=admin@example.com,ops@example.com
CRITICAL_ERROR_EMAIL_FROM=noreply@whatsapp-adapter.local

CRITICAL_ERROR_SLACK_ENABLED=false
CRITICAL_ERROR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

CRITICAL_ERROR_WEBHOOK_ENABLED=false
CRITICAL_ERROR_WEBHOOK_URL=https://your-monitoring-service.com/webhooks/critical

# Meta Production Settings

# Rate Limiting
META_RATE_LIMITING_ENABLED=true
META_HOURLY_LIMIT=200
META_DAILY_LIMIT=4800
META_MESSAGES_LIMIT_PER_MIN=60
META_CREATIVES_LIMIT_PER_MIN=30
META_INSIGHTS_LIMIT_PER_MIN=200
META_WEBHOOKS_LIMIT_PER_MIN=1000

# Retry Policy
META_RETRY_ENABLED=true
META_MAX_RETRIES=3
META_INITIAL_DELAY_MS=1000
META_MAX_DELAY_MS=16000

# Circuit Breaker
META_CIRCUIT_BREAKER_ENABLED=true
META_CB_FAILURE_THRESHOLD=5
META_CB_SUCCESS_THRESHOLD=2
META_CB_TIMEOUT_SECONDS=60
META_CB_WINDOW_SECONDS=300

# Alerts
META_ALERTS_ENABLED=true
META_ALERT_COOLDOWN_INFO=3600
META_ALERT_COOLDOWN_WARNING=1800
META_ALERT_COOLDOWN_ERROR=900
META_ALERT_COOLDOWN_CRITICAL=0
META_PERF_RESPONSE_TIME_MS=5000
META_PERF_ERROR_RATE=5.0
META_PERF_SUCCESS_RATE=95.0
META_TOKEN_EXPIRY_WARNING_DAYS=30

# Monitoring
META_MONITORING_ENABLED=true
META_METRICS_INTERVAL=60
META_METRICS_RETENTION_DAYS=30

# Timeouts
META_HTTP_TIMEOUT=30
META_CONNECT_TIMEOUT=10
META_WEBHOOK_TIMEOUT=15

# Cache
META_CACHE_ENABLED=true
META_CACHE_MESSAGE_STATUS_TTL=3600
META_CACHE_RATE_LIMIT_TTL=60
META_CACHE_CB_TTL=300

# Dead Letter Queue
META_DLQ_ENABLED=true
META_DLQ_MAX_ATTEMPTS=3
META_DLQ_RETENTION_DAYS=7

# Logging
META_LOG_LEVEL=info
META_LOG_PAYLOADS=false
META_LOG_HEADERS=false
META_MASK_SENSITIVE_DATA=true
