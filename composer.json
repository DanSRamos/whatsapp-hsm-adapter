{
  "name": "whatsapp/hsm-adapter",
  "description": "WhatsApp HSM Adapter for multi-provider integration (Infobip, Twilio, etc.)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "monolog/monolog": "^3.5",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "pestphp/pest": "^2.33",
    "pestphp/pest-plugin-faker": "^2.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "WhatsApp\\Adapter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WhatsApp\\Adapter\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "pest",
    "test:unit": "pest --testsuite=Unit",
    "test:property": "pest --testsuite=Property",
    "test:coverage": "pest --coverage"
  }
}
